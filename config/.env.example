# ============================================================
# CREDENCIALES DE SQL SERVER
# ============================================================
# Copiar como .env en la raíz del repositorio (está en .gitignore)
# o definir estas variables en el entorno del sistema / .Renviron.
#
# Solo se requieren cuando config.yml tiene fuente: sqlserver
# El modo demo no necesita ninguna credencial.

SQL_SERVER=nombre-del-servidor
SQL_DATABASE=nombre-de-la-base
SQL_USER=usuario
SQL_PASSWORD=contrasena
